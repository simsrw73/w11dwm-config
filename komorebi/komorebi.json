{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "mouse_follows_focus": false,
  "default_workspace_padding": 8,
  "default_container_padding": 6,
  "border": true,
  "border_width": 4,
  "border_offset": -1,
  "border_style": "System",
  "border_implementation": "Komorebi",
  "transparency": true,
  "transparency_alpha": 235,
  "animation": {
    "enabled": true,
    "duration": 180,
    "style": "EaseOutCubic"
  },
  "stackbar": {
    "mode": "Never"
  },
  "theme": {
    "palette": "Catppuccin",
    "name": "Mocha",
    "single_border": "Lavender",
    "stack_border": "Rosewater",
    "monocle_border": "Mauve",
    "floating_border": "Peach",
    "unfocused_border": "Surface0",
    "unfocused_locked_border": "Red",
    "bar_accent": "Lavender"
  },
  "display_index_preferences": {
    "0": "H6TNT84",
    "1": "209NTCZBE803"
  },
  "ignore_rules": [
    {
      "kind": "Exe",
      "id": "Koffee.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Bitwarden.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Task Manager.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "notepad.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "notepad++.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "Flow.Launcher.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "title",
      "id": "Settings"
    },
    [
      { "kind": "exe", "id": "zen.exe" },
      { "kind": "title", "id": "Extension:" }
    ]
  ],
